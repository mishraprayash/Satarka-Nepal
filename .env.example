# ==============================================================================
# Satarka Nepal - Environment Configuration Template
# ==============================================================================

# Application Base URL (used for canonical URLs, sitemaps, and robots.txt)
NEXT_PUBLIC_APP_URL=https://satarka.app

# Supabase Managed Database & PostGIS (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
CRON_SECRET=your-secure-cron-secret-token

# Nepal Disaster Risk Reduction & Management Authority (BIPAD Portal)
BIPAD_API_URL=https://bipadportal.gov.np/api/v1

# Department of Roads (DOR) National Highway Passability Feed
DOR_NAVIGATE_API_URL=https://navigate.dor.gov.np/api

# United States Geological Survey (USGS) Earthquake Hazards Program
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson

# Global Disaster Alert and Coordination System (GDACS - UN/EC)
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/EVENTS4APP

# GEOGloWS ECMWF Hydrological River Forecasting Service
GEOGLOWS_API_URL=https://geoglows.ecmwf.int/api/v2

# Open-Meteo High-Resolution Numerical Weather Prediction
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# UN OCHA ReliefWeb Humanitarian Reports API
RELIEFWEB_API_URL=https://api.reliefweb.int/v2/reports
RELIEFWEB_APPNAME=satarka.app


NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=